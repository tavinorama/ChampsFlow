 from http.cookies import SimpleCookie
 
 ROOT = Path(__file__).resolve().parent
+
+# B15 (Codex D21, 23/09/2026): the Railway deployment had no identity — the
+# service answered /health but nothing said WHICH code was running, and this
+# folder is deployed with `railway up` (no git SHA). The build id is a digest
+# of the application files computed at boot, so /version answers "this exact
+# code", reproducible from the same files. RAILWAY_GIT_COMMIT_SHA is reported
+# too when Railway sets it.
+BUILD_FILES = ('server.py', 'platform_store.py', 'business_validation.py', 'scrapling_adapter.py',
+               'client-app.js', 'platform.js', 'catalog.js', 'business-ui.js', 'automation.js',
+               'signals.js', 'quality-rules.js', 'import-tools.js', 'index.html', 'login.html')
+
+def compute_build_id(root):
+    """sha256 over the sorted application files, first 12 hex. Missing files are skipped, never guessed."""
+    h = hashlib.sha256(); hashed = []
+    for name in sorted(BUILD_FILES):
+        f = Path(root) / name
+        if not f.is_file():
+            continue
+        h.update(name.encode()); h.update(b'\0'); h.update(f.read_bytes()); h.update(b'\0'); hashed.append(name)
+    return h.hexdigest()[:12], hashed
+
+BUILD_ID, BUILD_FILES_HASHED = compute_build_id(ROOT)
+STARTED_AT = datetime.now(timezone.utc).isoformat()
 STATE = Path(os.environ.get('ATLAS_STATE_DIR', str(ROOT.parent.parent / 'work' / 'atlas-runtime')))
